# PostgreSQL credentials for docker-compose.yml
# Copy this file to .env and set a strong POSTGRES_PASSWORD before starting.
POSTGRES_DB=enphase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Optional: Number of trusted reverse proxies in front of the app (0 = disabled).
# Set to 1 if deployed behind a single reverse proxy (e.g., Nginx, Caddy, Traefik).
TRUST_PROXY_COUNT=0

# Optional: Override trmnl.api_key from configuration/config.yml
# TRMNL_API_KEY=change-me-to-a-strong-trmnl-token
